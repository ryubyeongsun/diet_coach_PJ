# =================================================================
# Diet Coach Project - 환경 변수 설정 템플릿 (.env.example)
# =================================================================
# 이 파일은 프로젝트 실행에 필요한 환경 변수 목록을 정의합니다.
# Spring Boot는 루트 .env 파일을 자동으로 읽지 않습니다.
# 아래 값을 IDE 실행 설정 또는 운영체제의 환경 변수로 등록하세요.

# DB 설정 덮어쓰기 (개발용 기본값은 application-dev.yml 참조)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/yumyum?serverTimezone=Asia/Seoul
# SPRING_DATASOURCE_USERNAME=your_db_username
# SPRING_DATASOURCE_PASSWORD=your_db_password

# [1] 공통 및 개발 환경 (Local/Dev)
# -----------------------------------------------------------------
# 11번가 오픈 API 키
ELEVENST_API_KEY=your_11st_api_key_here

# 네이버 쇼핑 API 설정
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# SSAFY GMS OpenAI API 설정 (식단 생성 AI)
GMS_API_KEY=your_gms_api_key_here

# JWT 토큰 비밀키 (최소 32자 이상의 임의 문자열 권장)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long


# [2] 운영 환경 (Production - 배포 서버용)
# -----------------------------------------------------------------
# 운영 DB 접속 정보
PROD_DB_HOST=your_production_db_host
PROD_DB_NAME=yumyum
PROD_DB_USERNAME=your_db_username
PROD_DB_PASSWORD=your_db_password

# 운영 환경용 API 키 (개발 환경과 다를 경우 설정)
PROD_JWT_SECRET=your_production_jwt_secret
PROD_ELEVENST_API_KEY=your_production_11st_api_key
PROD_NAVER_CLIENT_ID=your_production_naver_client_id
PROD_NAVER_CLIENT_SECRET=your_production_naver_client_secret
PROD_GMS_API_KEY=your_production_gms_api_key

# [3] 프론트엔드 (Vite 환경 변수)
# -----------------------------------------------------------------
# 현재 Axios baseURL은 /api이며 Vite proxy를 사용합니다.
# VITE_API_BASE_URL을 선언하는 것만으로 API 주소가 바뀌지 않습니다.
